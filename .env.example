# Base URL for the fixth API. Leave unset to use the relative `/api/v1`, which
# the Vite dev server proxies to http://localhost:8000 and Vercel rewrites to
# the Render backend. The backend has no CORS configuration, so pointing this
# at http://localhost:8000 directly makes every browser request fail.
# VITE_API_URL=/api/v1

# Show the OTP returned by a backend that cannot send email. This bypasses
# email verification — only enable it on throwaway demo deployments.
# VITE_SHOW_DEMO_OTP=true

# Show the Trust & Safety mock workspace (/admin) in a production build.
# It always shows in `npm run dev`.
# VITE_SHOW_ADMIN_PREVIEW=true
